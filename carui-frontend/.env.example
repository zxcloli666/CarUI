# CarUI Gateway Configuration
# Copy this file to .env and adjust values

# For Android emulator use: 10.0.2.2
# For physical device use your Pi/server IP: 192.168.x.x
GATEWAY_HOST=10.0.2.2
GATEWAY_PORT=8080

# Overpass API instance used for on-device speed-limit data (optional, has default)
#OVERPASS_URL=https://overpass-api.de/api/interpreter

# Mapbox token for the native mini-map (optional)
#MAPBOX_TOKEN=
