{
  "name": "CarUIApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "which react-native && react-native run-android",
    "android:clean": "cd android && ./gradlew clean",
    "build:apk": "cd android && ./gradlew assembleRelease --no-daemon",
    "build:aab": "cd android && ./gradlew bundleRelease --no-daemon",
    "build:clean": "cd android && ./gradlew clean assembleRelease --no-daemon",
    "start": "react-native start",
    "start:clean": "react-native start --reset-cache",
    "lint": "biome check .",
    "format": "biome check --write .",
    "sync-audio": "./scripts/sync-audio.sh"
  },
  "dependencies": {
    "@mhpdev/react-native-speech": "^1.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.1.2",
    "@react-navigation/material-top-tabs": "^7.4.13",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "@turf/distance": "^7.3.4",
    "lucide-react-native": "^0.562.0",
    "rbush": "^4.0.1",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-pager-view": "^8.0.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "^15.15.3",
    "react-native-worklets": "^0.7.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/runtime": "^7.28.6",
    "@biomejs/biome": "^2.3.14",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/node": "^25.2.3",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.14",
    "babel-plugin-module-resolver": "^5.0.2",
    "react-native-dotenv": "^3.4.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
